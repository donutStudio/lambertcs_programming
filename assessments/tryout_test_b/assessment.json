{
  "id": "tryout_test_b",
  "allowed_reference_sheets": [
    "py_reference",
    "java_reference",
    "cpp_reference"
  ],
  "title": "Lambert Competitive Programming Tryout B (Friday's actual test)",
  "time_limit_seconds": 1800,
  "number_of_attempts": 0,
  "passcode": "C0D3",
  "submittable_early": false,
  "auto_submit_on_leave": false,
  "score_visibility": {
    "while_taking": true,
    "upon_completion": true,
    "score_format": "integer"
  },
  "stimuli": {
    "instructions": {
      "$file": "instructions.md"
    },
    "dropping_grades": {
      "$file": "dropping_grades.md"
    },
    "fizzes_and_buzzes": {
      "$file": "fizzes_and_buzzes.md"
    },
    "splling": {
      "$file": "splling.md"
    }
  },
  "questions": [
    {
      "id": "instructions",
      "response_type": "stimulus_only",
      "stimulus": "instructions"
    },
    {
      "id": "fizzes_and_buzzes",
      "response_type": "code_editor",
      "stimulus": "fizzes_and_buzzes",
      "response_config": {
        "default_code": {
          "python": {
            "$file": "starter_code/fizzes_and_buzzes.py"
          },
          "java": {
            "$file": "starter_code/Problem1.java"
          },
          "cpp": {
            "$file": "starter_code/fizzes_and_buzzes.cpp"
          }
        },
        "grader": {
          "code": {
            "$file": "tests/fizzes_and_buzzes.py"
          },
          "assets": {
            "cases": {
              "$file": "tests/fizzes_and_buzzes.txt"
            }
          }
        }
      }
    },
    {
      "id": "splling",
      "response_type": "code_editor",
      "stimulus": "splling",
      "response_config": {
        "default_code": {
          "python": {
            "$file": "starter_code/splling.py"
          },
          "java": {
            "$file": "starter_code/Problem2.java"
          },
          "cpp": {
            "$file": "starter_code/splling.cpp"
          }
        },
        "grader": {
          "code": {
            "$file": "tests/splling.py"
          },
          "assets": {
            "cases": {
              "$file": "tests/splling.txt"
            }
          }
        }
      }
    },
    {
      "id": "dropping_grades",
      "response_type": "code_editor",
      "stimulus": "dropping_grades",
      "response_config": {
        "default_code": {
          "python": {
            "$file": "starter_code/dropping_grades.py"
          },
          "java": {
            "$file": "starter_code/Problem3.java"
          },
          "cpp": {
            "$file": "starter_code/dropping_grades.cpp"
          }
        },
        "grader": {
          "code": {
            "$file": "tests/dropping_grades.py"
          },
          "assets": {
            "cases": {
              "$file": "tests/dropping_grades.txt"
            }
          }
        }
      }
    }
  ],
  "response_defaults": {
    "code_editor": {
      "supported_languages": [
        "python",
        "java",
        "cpp"
      ],
      "grader": {
        "max_score": 100
      }
    }
  },
  "required_credentials": [
    "full_name",
    "email",
    "student_id"
  ]
}
